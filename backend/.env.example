# Copy to .env and fill in. .env is git-ignored and must never be committed.
# No secret in this file may ever be exposed through the Vite client bundle
# or a VITE_* variable (spec section 13).

DB_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/marvel

SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

REDIS_HOST=localhost
REDIS_PORT=6379

# Commerce
DEFAULT_CURRENCY=EGP
DEFAULT_LOCALE=en
HOUSE_BRAND=Pixi

# Order identity — section 2 requires an immutable, never-regenerated order id
ORDER_NUMBER_PREFIX=ORD

# Idempotency retention (open question 5 — confirm against gateway retry horizon)
IDEMPOTENCY_TTL_HOURS=24

# Cart lifecycle (open question 6)
GUEST_CART_TTL_DAYS=30
CUSTOMER_CART_TTL_DAYS=90
CART_ABANDONED_AFTER_HOURS=24
