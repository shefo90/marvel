# Never in an image. backend/.env holds real database credentials, and a COPY
# that sweeps it in bakes them into a layer anyone who pulls the image can read.
.env
*.env
!*.env.example

# A host virtualenv is the wrong platform's binaries and hundreds of megabytes.
# The image installs its own from requirements.txt.
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# Uploaded photographs live in a volume, not in the image.
media/
