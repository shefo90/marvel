# Where the renderer reaches the API from the server side. In the browser the
# same calls go to /api on this origin, through the proxy (dev) or the reverse
# proxy (production).
API_ORIGIN=http://localhost:8000

# The public origin, used for canonical URLs and hreflang. Must match the
# backend's SITE_BASE_URL or the two will disagree about what the canonical
# address of a page is.
PUBLIC_ORIGIN=http://localhost:3000

# Google Tag Manager container. Left blank, the Consent Mode v2 defaults are
# still set -- so a container added later starts from denied rather than from
# nothing. Every tag (GA4, Meta, TikTok) is configured inside GTM, never in
# application code: a pixel fired from a component is a tag nobody can see,
# version or switch off.
GTM_CONTAINER_ID=
