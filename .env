# Copy to `.env` and fill in for a real deployment.
#
#     cp .env.example .env
#
# `.env` is gitignored (the root .gitignore excludes *.env and keeps
# *.env.example). Nothing in this file should ever hold a real value.
#
# **Not needed for local development.** docker-compose.yml carries a
# development default for everything here, so `docker compose up -d` works with
# no .env at all. Those defaults are in a tracked file and therefore public,
# which is exactly why production needs this one.
#
#     docker compose up -d --build

# --- secrets ----------------------------------------------------------------
# Signs every access and refresh token, staff and shopper alike. Anyone holding
# it can mint a token for any account, including an admin, so it is the single
# most valuable string here. Generate a fresh one -- do not reuse the
# development value, which is in a tracked file and therefore public:
#
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Changing it later signs everyone out, which is the correct response to a leak.
SECRET_KEY=oN5j6gKibs_ValARr96oHJFKSAnf0IcQS5eVrUnrq6I_8EWr2woNiiZAKsS8kJzm

# The database password. Also generate this rather than choosing it:
#
#     python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=ZFjzletJAhE2qacZnvtAhz-pQP2nJX-W

POSTGRES_USER=marvel
POSTGRES_DB=marvel

# --- addresses --------------------------------------------------------------
# The public address of the shop, with scheme and no trailing slash. It is
# printed into canonical tags, hreflang alternates, the sitemap and JSON-LD, so
# a wrong value here is not cosmetic: it tells Google the real pages live
# somewhere else.
#
#   before DNS:   http://203.0.113.10
#   after DNS:    https://marvelshop.example
PUBLIC_ORIGIN=http://169.58.88.60

# Force the shopper session cookie to be marked Secure. Left empty the API
# decides from the request scheme, which is already correct behind Caddy --
# but setting it explicitly is what arms the SECRET_KEY check in
# backend/core/config.py, so production should always set it to 1.
COOKIE_SECURE=1

# The domain Caddy should obtain a certificate for. Leave EMPTY until DNS
# actually points at this server -- Let's Encrypt validates by connecting to the
# name, and repeated failures burn a rate limit that locks issuance for a week.
#
# Empty  -> plain HTTP on port 80, reachable by IP. Correct before DNS.
# Set    -> automatic HTTPS, renewed without a cron job.
#
# When you set this, set PUBLIC_ORIGIN to the https:// form in the same edit.
SITE_DOMAIN=

# --- shop -------------------------------------------------------------------
HOUSE_BRAND=Pixi
ORDER_NUMBER_PREFIX=ORD
