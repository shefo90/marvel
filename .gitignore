# Secrets — backend/.env holds real DB credentials. .env.example is tracked instead.
.env
*.env
!*.env.example
# Root .env is tracked on purpose so it can be pulled directly on the VPS.
!/.env

# Python
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/

# Node / frontend (S2, not built yet)
node_modules/
dist/
.vite/

# Claude Code local machine settings — settings.json IS tracked, this one is per-machine
.claude/settings.local.json

# OS
Thumbs.db
Desktop.ini
.DS_Store
backend/media/
storefront/dist/

# Source photography handed over for import, not application assets.
# scripts/import_local_images.py copies these into the media store, where the
# app actually serves them from; the originals are large, are nobody's build
# input, and belong in whatever the shop uses for master files.
storefront/assets/shoes images/
storefront/assets/bags/

# Local backup output. These contain real order data.
backups/
